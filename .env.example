# ==================================================
# Hyeoniverse Portfolio — Environment Variables
# ==================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# --------------------------------------------------
# Site (Required for production)
# 미들웨어 CSRF Origin 체크 기준값. production 에 미설정 시 모든 admin mutation 이 403.
# dev 환경은 skip (편의) — 잡고 싶으면 SITE_URL=http://localhost:3000
# --------------------------------------------------
SITE_URL=

# --------------------------------------------------
# Supabase (Required)
# https://supabase.com
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 소유자(owner) 이메일 — 이 계정은 app_metadata 없이도 전권(owner)으로 인정된다.
# 다중 저자(role/권한) 부트스트랩용. (이슈 #334)
OWNER_EMAIL=

# --------------------------------------------------
# Contact Form (choose one)
# --------------------------------------------------

# Web3Forms — https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=

# Formspree — https://formspree.io
NEXT_PUBLIC_FORMSPREE_ID=

# EmailJS — https://emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --------------------------------------------------
# reCAPTCHA
# https://www.google.com/recaptcha
# --------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --------------------------------------------------
# Unsplash (cover image search)
# https://unsplash.com/developers
# --------------------------------------------------
UNSPLASH_ACCESS_KEY=

# --------------------------------------------------
# AI Image Generation (choose one)
# --------------------------------------------------
NANOBANANA_API_KEY=
HUGGINGFACE_API_KEY=

# --------------------------------------------------
# Translation (choose one)
# --------------------------------------------------

# DeepL API Free — https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Gemini 2.0 Flash — https://ai.google.dev
GEMINI_API_KEY=

# Google Cloud Translation — https://cloud.google.com/translate
GOOGLE_TRANSLATE_API_KEY=

# --------------------------------------------------
# Email Notifications
# https://resend.com
# --------------------------------------------------
RESEND_API_KEY=

# --------------------------------------------------
# GitHub API 토큰 (선택) — 프로필·홈의 GitHub 연동(저장소 목록·조직 저장소·활동 지표)과
# giscus 댓글의 Discussion 카테고리 조회에 사용. 공개 저장소 읽기용 PAT 면 충분하다
# (권한 없이도 공개 데이터 조회 가능). 없으면 익명으로 조회하는데, IP당 시간 60회 제한이라
# 소진되면 조직 저장소가 간헐적으로 빠진다.
# 주의: 조직은 만료 기한이 366일을 넘는 fine-grained(github_pat_) 토큰을 거부할 수 있다 —
# 조직 저장소가 안 잡히면 기한을 1년 이하로 줄여 다시 발급할 것. classic(ghp_)은 무관.
# --------------------------------------------------
GITHUB_TOKEN=

# 시각 회귀 admin 테스트 계정 (선택 — npm run test:visual:admin 실행 시에만 필요)
# Supabase Dashboard → Authentication → Users → Add user (Auto Confirm 체크) 로 생성
# 최초 1회는 새 기기 승인 메일을 눌러야 통과한다 (e2e/auth.setup.ts 참고)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
