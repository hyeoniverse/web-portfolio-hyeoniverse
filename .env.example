# ==================================================
# Oval Portfolio — Environment Variables
# ==================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# --------------------------------------------------
# Site (Required for production)
# 미들웨어 CSRF Origin 체크 기준값. production 에 미설정 시 모든 admin mutation 이 403.
# dev 환경은 skip (편의) — 잡고 싶으면 NEXT_PUBLIC_SITE_URL=http://localhost:3000
# --------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --------------------------------------------------
# Supabase (Required)
# https://supabase.com
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 소유자(owner) 이메일 — 이 계정은 app_metadata 없이도 전권(owner)으로 인정된다.
# 다중 저자(role/권한) 부트스트랩용. (이슈 #334)
OWNER_EMAIL=

# --------------------------------------------------
# Contact Form (choose one)
# --------------------------------------------------

# Web3Forms — https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=

# Formspree — https://formspree.io
NEXT_PUBLIC_FORMSPREE_ID=

# EmailJS — https://emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --------------------------------------------------
# reCAPTCHA
# https://www.google.com/recaptcha
# --------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --------------------------------------------------
# Unsplash (cover image search)
# https://unsplash.com/developers
# --------------------------------------------------
UNSPLASH_ACCESS_KEY=

# --------------------------------------------------
# AI Image Generation (choose one)
# --------------------------------------------------
NANOBANANA_API_KEY=
HUGGINGFACE_API_KEY=

# --------------------------------------------------
# Translation (choose one)
# --------------------------------------------------

# DeepL API Free — https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Gemini 2.0 Flash — https://ai.google.dev
GEMINI_API_KEY=

# Google Cloud Translation — https://cloud.google.com/translate
GOOGLE_TRANSLATE_API_KEY=

# --------------------------------------------------
# Email Notifications
# https://resend.com
# --------------------------------------------------
RESEND_API_KEY=

# --------------------------------------------------
# giscus 댓글 설정 (선택) — admin 설정에서 저장소의 Discussion 카테고리를
# 불러올 때만 사용. 공개 저장소 읽기용 GitHub PAT (권한 없이도 공개 데이터 조회 가능).
# --------------------------------------------------
GITHUB_TOKEN=

# 시각 회귀 admin 테스트 계정 (선택 — npm run test:visual:admin 실행 시에만 필요)
# Supabase Dashboard → Authentication → Users → Add user (Auto Confirm 체크) 로 생성
# 최초 1회는 새 기기 승인 메일을 눌러야 통과한다 (e2e/auth.setup.ts 참고)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
