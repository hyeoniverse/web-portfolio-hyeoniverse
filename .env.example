# ==================================================
# Hyeoniverse — 환경 변수
# ==================================================
# .env.example 을 .env.local 로 복사해 채운다:  cp .env.example .env.local
#
# 우선순위: 관리자 설정 › 서비스 › 환경 변수에서 저장한 값(DB)이 이 파일보다 먼저 쓰인다.
# 그 화면에서 편집할 수 없는 값(Supabase·SITE_URL·OWNER_EMAIL·CRON_SECRET 등)은 여기와
# Vercel 환경 변수에서만 정한다. 비워 둔 항목은 그 기능만 꺼지고 나머지는 동작한다.

# --------------------------------------------------
# 사이트 (배포 필수)
# SITE_URL — 사이트 주소(https://www.example.com). CSRF Origin 검사와 메일 발신 도메인의 기준.
# 배포에서 비어 있으면 관리자 쓰기 요청이 전부 403. 로컬은 검사를 건너뛴다.
# --------------------------------------------------
SITE_URL=

# --------------------------------------------------
# 소유자 · 알림 받을 주소
# OWNER_EMAIL — 이 계정은 app_metadata 없이도 소유자(owner) 권한으로 인정된다.
# ADMIN_EMAIL — 문의·알림 메일 받을 주소. 사이트 설정의 연락처 이메일이 있으면 그쪽이 먼저. (선택)
# --------------------------------------------------
OWNER_EMAIL=
ADMIN_EMAIL=

# --------------------------------------------------
# Supabase (필수) — https://supabase.com
# SERVICE_ROLE_KEY 는 RLS 를 우회하는 서버 전용 키. 클라이언트에 노출 금지.
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------
# 문의 폼 — 셋 중 하나 (사이트 설정에서 고른 공급자)
# Web3Forms https://web3forms.com · Formspree https://formspree.io · EmailJS https://emailjs.com
# --------------------------------------------------
NEXT_PUBLIC_WEB3FORMS_KEY=
NEXT_PUBLIC_FORMSPREE_ID=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --------------------------------------------------
# reCAPTCHA — https://www.google.com/recaptcha
# 문의 폼 스팸 방지. 사이트 설정에서 reCAPTCHA 를 켰을 때만 필요.
# --------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --------------------------------------------------
# 알림 메일 — https://resend.com
# --------------------------------------------------
RESEND_API_KEY=

# --------------------------------------------------
# 커버 이미지 검색
# Unsplash https://unsplash.com/developers · Pexels https://www.pexels.com/api
# --------------------------------------------------
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --------------------------------------------------
# AI 이미지 생성 — 하나만 있어도 된다
# --------------------------------------------------
NANOBANANA_API_KEY=
HUGGINGFACE_API_KEY=

# --------------------------------------------------
# 번역 · AI 요약
# 번역: DeepL https://www.deepl.com/pro-api · Google Cloud Translation https://cloud.google.com/translate
# Gemini https://ai.google.dev 는 번역·요약·이미지 생성에 두루 쓰인다.
# 요약: OpenAI https://platform.openai.com · Anthropic https://console.anthropic.com
# --------------------------------------------------
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --------------------------------------------------
# 슬라이드 음성 (TTS) — 둘 다 선택
# 순서: Fish Audio → Google Cloud TTS → Edge TTS(키 없음). 앞이 실패하면 다음으로 넘어간다.
# Fish Audio https://fish.audio — 무료 모델 s2.1-pro-free 는 2026-11-30 까지.
# Google Cloud TTS — 앱이 한 달 80만 바이트에서 멈춘다. 키는 Text-to-Speech API 만 허용하도록 제한할 것.
# --------------------------------------------------
FISH_AUDIO_API_KEY=
GOOGLE_TTS_API_KEY=

# --------------------------------------------------
# GitHub 연동 (선택)
# 프로필·홈의 저장소 목록·활동 지표, giscus 카테고리 조회. 공개 저장소 읽기 PAT 면 충분.
# 없으면 익명 조회(IP 당 시간 60회) — 소진되면 조직 저장소가 간헐적으로 빠진다.
# 조직은 만료 366일 초과 fine-grained(github_pat_) 토큰을 거부할 수 있다 → 1년 이하로 발급.
# --------------------------------------------------
GITHUB_TOKEN=

# --------------------------------------------------
# 주기 작업 (선택)
# CRON_SECRET — 예약 발행·휴지통 정리를 외부(cron-job.org 등)에서 부를 때의 비밀 값.
# 평소엔 Supabase 안에서 돌아서 비워 둬도 된다. 관리자 화면에서는 편집 불가.
# --------------------------------------------------
CRON_SECRET=

# --------------------------------------------------
# 테스트 (선택) — npm run test:visual:admin 에만 필요
# Supabase › Authentication › Users › Add user(Auto Confirm)로 만든 계정.
# 처음 한 번은 새 기기 승인 메일을 눌러야 통과한다(e2e/auth.setup.ts).
# --------------------------------------------------
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
