# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
src/config/hyeon.config.ts

# claude code — 개인 환경 설정 (permissions, hooks, worktrees) — 공유 X
.claude/

# works 인트로 배경 영상 — GitHub 100MB 제한 회피.
# 로컬 dev 는 public/intro-bg.mp4 드롭, 배포는 siteConfig.works.introVideoUrl 로 외부 CDN 지정.
/public/intro-bg.mp4

# playwright 시각 회귀 — baseline 스냅샷(e2e/**/*-snapshots)만 커밋하고 실행 산출물은 제외
/e2e/.results/
/e2e/.report/
# admin 로그인 세션 — 인증 토큰이 들어 있다. 절대 커밋 금지
/e2e/.auth/

# content/ 의 이미지를 빌드 앞에서 복사해 넣는 자리 (scripts/sync-content-assets.ts).
# 원본은 content/ 하나뿐이라 생성물은 추적하지 않는다.
/public/content
