# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
src/config/hyeon.config.ts

# claude code — 개인 환경 설정 (permissions, hooks, worktrees) — 공유 X
.claude/

# works 인트로 배경 영상 — GitHub 100MB 제한 회피.
# 로컬 dev 는 public/intro-bg.mp4 드롭, 배포는 siteConfig.works.introVideoUrl 로 외부 CDN 지정.
/public/intro-bg.mp4
