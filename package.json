{
  "name": "web-portfolio-arc",
  "version": "1.53.17",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/sync-content-assets.ts && tsx scripts/gen-about-fallback.ts && next dev --turbopack",
    "fonts:scan": "node scripts/scan-fonts.mjs",
    "prebuild": "node scripts/scan-fonts.mjs && tsx scripts/sync-content-assets.ts && tsx scripts/gen-about-fallback.ts",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint --max-warnings 356",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "type-coverage": "type-coverage --strict --ignore-files \".next/**\" --at-least 97.93",
    "knip": "knip",
    "knip:deps": "knip --include unlisted,unresolved",
    "audit:full": "npm run typecheck && npm run lint && npm run lint:css && npm run knip",
    "sync-posts": "tsx scripts/sync-posts.ts",
    "sync-posts:dry": "tsx scripts/sync-posts.ts --dry",
    "sync-works": "tsx scripts/sync-works.ts",
    "sync-works:dry": "tsx scripts/sync-works.ts --dry",
    "sync-all": "tsx scripts/sync-posts.ts && tsx scripts/sync-works.ts && tsx scripts/sync-about.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "test:smoke": "playwright test --project=desktop --project=mobile",
    "test:smoke:admin": "playwright test --project=admin",
    "test:api": "playwright test --project=api --project=api-auth",
    "sync-content-assets": "tsx scripts/sync-content-assets.ts",
    "sync-about": "tsx scripts/sync-about.ts",
    "sync-about:dry": "tsx scripts/sync-about.ts --dry",
    "sync-about:eject": "tsx scripts/sync-about.ts --eject",
    "gen-about-fallback": "tsx scripts/gen-about-fallback.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
