// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`getVizParts > 전체 키 × 위치 마크업 스냅샷 1`] = `
{
  "all-param-leak/cause": "<div class="viz"><figure class="fig"><div class="row seq"><div class="dev"><div class="ic">🪪</div><div class="nm">세션 클라이언트</div><div class="sub">요청자 세션 그대로 전달</div><span class="chip fresh"><span class="dot"></span>RLS 가 막아 준다</span></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><div class="ic">📗</div><div class="nm">발행된 글만</div><div class="sub">공개 창구</div></div></div><div class="row seq"><div class="dev"><div class="ic">🗝️</div><div class="nm">service-role</div><div class="sub">RLS 우회</div><span class="chip bad"><span class="dot"></span>API 코드가 확인해야 한다</span></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><div class="ic">📕</div><div class="nm">모든 행</div><div class="sub">초안 · 휴지통 포함</div></div></div><div class="row seq"><div class="dev"><div class="ic">🪪</div><div class="nm">세션 클라이언트</div><div class="sub">규칙이 요청자를 본다</div><span class="chip fresh"><span class="dot"></span>우회할 이유가 없어진다</span></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><div class="ic">📘</div><div class="nm">권한이 닿는 행</div><div class="sub">발행된 글 + 다룰 수 있는 글</div></div></div><figcaption class="cap">RLS 를 우회하는 경로를 열면, 요청자가 관리자인지 확인할 책임이 데이터베이스에서 API 코드로 넘어온다.</figcaption></figure></div>",
  "all-param-leak/definition": "<div class="viz"><figure class="fig"><div class="row"><div class="dev"><span class="codePill">?all=true</span><span class="chip sync"><span class="dot"></span>인증 없음</span></div><div class="arrow"><span class="ln">→</span><span class="lb">공개 GET</span></div><div class="dev"><div class="ic">🗄️</div><div class="nm">목록 API</div></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><div class="ic">🔓</div><div class="nm">응답</div><span class="chip bad"><span class="dot"></span>비공개+휴지통 전부</span></div></div><figcaption class="cap">화면 표시용 쿼리 파라미터가 인증 경계 밖에서 전 데이터를 반환하고 있었다.</figcaption></figure></div>",
  "all-param-leak/solution": "<div class="viz"><figure class="fig"><div class="cmp"><div class="ch">비교</div><div class="ch">이전</div><div class="ch">이후</div><div class="cell">DB 접근</div><div class="cell bad">service-role · 규칙 우회</div><div class="cell win">요청자 세션 · 규칙 적용</div><div class="cell">인가 판정</div><div class="cell bad">API 코드</div><div class="cell win">데이터베이스 규칙</div><div class="cell">?all=true 응답</div><div class="cell bad">인증 없이 전부</div><div class="cell win">권한이 닿는 만큼</div><div class="cell">코드가 검문을 빠뜨리면</div><div class="cell bad">그대로 노출</div><div class="cell win">규칙이 막는다</div></div><figcaption class="cap">인가 판정이 API 코드에서 데이터베이스 규칙으로 옮겨 갔다.</figcaption></figure></div>",
  "anon-comment-auth/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">비밀번호(bcrypt)</span><span class="step">OR</span><span class="step stepMono">commenter_hash <span class="dim">(31-bit)</span></span><div class="arrow"><span class="ln">→</span><span class="lb">OR 로 뚫림</span></div><span class="step"><span class="chip bad"><span class="dot"></span>비밀번호 없이 통과</span></span></div><figcaption class="cap">인증이 강한 경로와 약한 경로를 OR 로 묶어 두면, 시스템의 강도는 약한 쪽을 따라간다.</figcaption></figure></div>",
  "anon-comment-auth/solution": "<div class="viz"><figure class="fig"><div class="row seq"><div class="dev"><span class="seqNum">1</span><div class="ic">📄</div><div class="nm">공개 GET</div><div class="sub">commenter_hash</div></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><span class="seqNum">2</span><div class="ic">🔑</div><div class="nm">같은 해시 찾기</div><div class="sub">31비트 · 약 30분</div></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><span class="seqNum">3</span><div class="ic">⌨️</div><div class="nm">curl 요청</div><div class="sub">비밀번호 없음</div></div></div><figcaption class="cap">공개된 해시 하나만 맞추면 비밀번호 없이 남의 댓글을 수정·삭제할 수 있었다.</figcaption></figure></div><div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxNo">이전: 강한 경로 OR 약한 경로 <span class="chip bad"><span class="dot"></span>약한 쪽으로 뚫림</span></div><div class="arrow"><span class="ln">→</span></div><div class="box boxOk">이후: 비밀번호 단일 경로 <span class="chip fresh"><span class="dot"></span>서버도 강제</span></div></div><figcaption class="cap">클라이언트가 강제한다고 서버가 강제하는 것은 아니다. 인증 경로를 비밀번호 하나로 통일했다.</figcaption></figure></div>",
  "backdrop-layer/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">.home <span class="dim">transform + will-change</span></span><div class="arrow"><span class="ln">→</span></div><span class="step">자체 compositing layer 승격</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip bad"><span class="dot"></span>layer 너머 못 샘플 → blur 안 보임</span></span></div><figcaption class="cap">framer-motion 이 남긴 transform/will-change 로 .home 이 자체 compositing layer 로 승격돼, 버튼의 backdrop-filter 가 layer 경계 너머 canvas 를 샘플하지 못했다.</figcaption></figure></div>",
  "backdrop-layer/definition": "<div class="viz"><figure class="fig"><div class="layers"><div class="layerCol"><div class="layerHd cut">✗ 분리 — .home 이 자체 layer</div><div class="layerBox cut"><div class="zrow">🔘 버튼 · backdrop-filter</div><div class="zrow">.home</div></div><div class="reach cut">↑ blur 는 이 layer 안만 샘플</div><div class="zrow canvas">☕ 커피 canvas — layer 밖</div><div class="layerFoot"><span class="chip bad"><span class="dot"></span>canvas 안 보임 → blur 텅 빔</span></div></div><div class="layerCol"><div class="layerHd thru">✓ 통합 — 일반 layer</div><div class="layerBox thru"><div class="zrow">🔘 버튼 · backdrop-filter</div><div class="zrow">.home</div><div class="zrow canvas">☕ 커피 canvas — 같은 layer</div></div><div class="reach thru">↓ blur 가 canvas 까지 샘플</div><div class="layerFoot"><span class="chip fresh"><span class="dot"></span>canvas 보임 → blur 정상</span></div></div></div><figcaption class="cap">backdrop-filter 는 자기가 속한 compositing layer 안의 픽셀만 샘플할 수 있다. .home 이 별도 layer 로 승격되면 그 아래 커피 canvas 는 layer 밖이라 blur 가 비빌 대상이 사라진다.</figcaption></figure></div>",
  "backdrop-layer/insight": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">☕ 배경</span><div class="arrow"><span class="ln">→</span><span class="lb">같은 layer</span></div><span class="step stepMono">backdrop-filter: blur()</span><span class="step"><span class="chip fresh"><span class="dot"></span>샘플 O · blur 보임</span></span></div><div class="steps"><span class="step">☕ 배경</span><div class="arrow"><span class="xmark">↮</span><span class="lb">조상 transform → layer 분리</span></div><span class="step stepMono">backdrop-filter: blur()</span><span class="step"><span class="chip bad"><span class="dot"></span>배경 = 없는 것</span></span></div><figcaption class="cap">같은 filter인데 위는 되고 아래는 안 된다. 바뀐 건 요소가 아니라 배경과 요소 사이의 layer 경계다. 조상 경로 어딘가에 transform·filter·isolate 가 끼면 그 너머 배경은 &quot;없는 것&quot; 이 되므로, filter 를 의심하기 전에 조상 체인부터 확인한다.</figcaption></figure></div>",
  "backdrop-layer/solution": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">y (transform)</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">marginTop (layout)</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip fresh"><span class="dot"></span>layer 안 생김 → blur 정상</span></span></div><figcaption class="cap">진입 애니메이션을 transform(y) 에서 layout(marginTop) 으로 바꿨다. layout 속성은 compositing layer 를 만들지 않는다.</figcaption></figure></div>",
  "block-deserialize/definition": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">편집기: 토글 · 콜아웃 · 열블록</span><div class="arrow"><span class="ln">→</span><span class="lb">직렬화</span></div><span class="step stepMono">HTML</span><div class="arrow"><span class="ln">→</span><span class="lb">역직렬화</span></div><span class="step"><span class="chip bad"><span class="dot"></span>복원 실패 → 사라짐</span></span></div><figcaption class="cap">저장(직렬화) 후 다시 불러올 때(역직렬화) deserializer 가 이 블록들을 복원하지 못해 사라졌다.</figcaption></figure></div>",
  "block-deserialize/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxNo">이전 <span class="chip bad"><span class="dot"></span>저장 후 소실</span></div><div class="arrow"><span class="ln">→</span></div><div class="box boxOk">이후 <span class="chip fresh"><span class="dot"></span>그대로 복원</span></div></div><figcaption class="cap">deserializer 가 이 블록 타입을 인식해 노드로 되돌리도록 고쳤다.</figcaption></figure></div>",
  "codeblock-highlight/definition": "<div class="viz"><figure class="fig"><div class="row"><div class="dev"><div class="nm">빌드</div><span class="chip fresh"><span class="dot"></span>통과</span></div><div class="dev"><div class="nm">테스트</div><span class="chip fresh"><span class="dot"></span>통과</span></div><div class="dev"><div class="ic">💥</div><div class="nm">브라우저</div><span class="chip bad"><span class="dot"></span>페이지 죽음</span></div></div><figcaption class="cap">빌드도 테스트도 통과하는데 브라우저에서만 페이지가 죽었다. 런타임에만 터지는 함정이었다.</figcaption></figure></div>",
  "codeblock-highlight/insight": "<div class="viz"><figure class="fig"><div class="row"><div class="dev"><span class="ic">🧪</span><span class="nm">빌드 · 타입 · 테스트</span><span class="sub">node / CI</span></div><span class="chip fresh"><span class="dot"></span>모두 통과</span><div class="arrow"><span class="xmark">↮</span><span class="lb">보장 못 함</span></div><div class="dev"><span class="ic">🌐</span><span class="nm">브라우저 런타임</span><span class="sub">highlight.js</span></div><span class="chip bad"><span class="dot"></span>여기서만 깨짐</span></div><figcaption class="cap">빌드·타입검사·테스트가 다 통과해도, 그게 도는 환경과 코드가 실제로 실행되는 브라우저가 다르면 그 간극의 문제는 테스트가 못 잡는다.</figcaption></figure></div>",
  "codeblock-highlight/solution": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">리더 · 댓글</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip fresh"><span class="dot"></span>Prism</span></span><span class="step stepMono">에디터(Plate)</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip fresh"><span class="dot"></span>hljs 문법 패치</span></span></div><figcaption class="cap">리더·댓글은 Prism 으로 교체(유니코드 이스케이프 없음), 에디터는 hljs 문법을 등록 시 패치했다.</figcaption></figure></div>",
  "cross-device-autosave/definition": "<div class="viz"><figure class="fig"><div class="row"><div class="dev"><div class="ic">📱</div><div class="nm">휴대폰</div><span class="chip fresh"><span class="dot"></span>방금 씀 · v3</span></div><div class="arrow"><span class="xmark">↮</span><span class="lb">이어지지 않음</span></div><div class="dev"><div class="ic">💻</div><div class="nm">노트북</div><span class="chip stale"><span class="dot"></span>열어보니 · v1</span></div></div><figcaption class="cap">기기 사이에 최신본이 전달되지 않으면 이런 일이 생긴다.</figcaption></figure></div>",
  "cross-device-autosave/insight": "<div class="viz"><figure class="fig"><div class="guard"><div class="guardRow"><div class="box"><span class="boxQ">리비전 시각 &gt; 저장본 시각?</span></div><div class="arrow"><span class="ln">→</span><span class="lb">예</span></div><div class="box boxOk"><span class="chip fresh"><span class="dot"></span>최신본으로 이어 씀</span></div></div><div class="guardRow"><div class="box" style="visibility:hidden" aria-hidden="true"><span class="boxQ">?</span></div><div class="arrow"><span class="ln">→</span><span class="lb">아니오</span></div><div class="box boxNo"><span class="chip sync"><span class="dot"></span>무시 · 저장본 유지</span></div></div></div><figcaption class="cap">옛 리비전이 최신으로 오인되는 경로를 가드가 막는다. 그 위에서 교차 기기 로딩을 다시 켠다.</figcaption></figure></div>",
  "cross-device-autosave/solution": "<div class="viz"><figure class="fig"><div class="row"><div class="dev"><div class="ic">📱</div><div class="nm">휴대폰</div><span class="chip fresh"><span class="dot"></span>v3 편집</span></div><div class="arrow"><span class="ln">→</span><span class="lb">① 리비전 저장</span></div><div class="cloud"><div class="hd">☁ 서버 리비전</div><div class="stack"><div class="rev top"><span>v3 · 최신</span><span>12:05</span></div><div class="rev"><span>v2</span><span>12:01</span></div></div></div><div class="arrow"><span class="ln">→</span><span class="lb">② 최신 불러오기</span></div><div class="dev"><div class="ic">💻</div><div class="nm">노트북</div><span class="chip fresh"><span class="dot"></span>v3 로 이어 씀</span></div></div><figcaption class="cap">서버 리비전이 다리 역할을 해서, 마지막으로 쓴 버전이 다음 기기로 넘어간다.</figcaption></figure></div><div class="viz"><figure class="fig"><div class="cmp"><div class="ch">후보</div><div class="ch" style="text-align:right">마지막 시각</div><div class="ch"></div><div class="cell">서버 최종 저장 본문 <span class="dim">(posts.content)</span></div><div class="cell num">12:00</div><div class="cell"></div><div class="cell win">서버 최신 리비전</div><div class="cell num win">12:05</div><div class="cell win"><span class="badge">← 채택</span></div><div class="cell">localStorage <span class="dim">(이 브라우저)</span></div><div class="cell num">11:58</div><div class="cell"></div></div><div class="note"><div class="noteT">🛡 단, 지금 편집 중이면 덮지 않는다</div><p class="noteP">이미 고치기 시작했다면 서버 최신본이 더 새로워 보여도 <span class="strong">덮어쓰지 않는다.</span> 방금 한 작업을 지우지 않는 것이 항상 먼저다.</p></div></figure></div>",
  "cursor-hittest/cause": "<div class="viz"><figure class="fig"><div class="row"><div class="dev"><div class="nm">위치 보간</div><span class="chip fresh"><span class="dot"></span>가벼움 · 매 프레임</span></div><div class="dev"><div class="nm">hit-test</div><div class="sub">elementsFromPoint</div><span class="chip bad"><span class="dot"></span>무거움</span></div><div class="arrow"><span class="xmark">↮</span><span class="lb">한 루프에 묶임</span></div><div class="dev"><div class="ic">🐢</div><div class="nm">둘 다 느려짐</div></div></div><figcaption class="cap">무거운 hit-test 와 가벼운 위치 보간이 한 프레임 루프에 묶여, hit-test 가 보간까지 함께 느리게 만들었다.</figcaption></figure></div>",
  "cursor-hittest/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxOk"><span class="chip fresh"><span class="dot"></span>보간: 매 프레임</span></div><div class="box boxOk"><span class="chip sync"><span class="dot"></span>hit-test: throttle</span></div></div><figcaption class="cap">hit-test 를 분리해 빈도를 낮췄다. 커서 위치는 매 프레임 부드럽게, hit-test 는 가끔만.</figcaption></figure></div>",
  "db-cron/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">호스팅 cron</span><div class="arrow"><span class="ln">→</span><span class="lb">HTTP</span></div><span class="step stepMono">/api/cron/…<span class="chip bad"><span class="dot"></span>공개 입구 · 비밀키 필요</span></span><div class="arrow"><span class="ln">→</span></div><span class="step">데이터베이스</span></div><figcaption class="cap">HTTP cron 은 안쪽 일을 시키려고 바깥에 입구를 하나 열고, 그 입구를 지키는 코드까지 함께 관리해야 한다.</figcaption></figure></div>",
  "db-cron/solution": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">pg_cron</span><div class="arrow"><span class="ln">→</span><span class="lb">DB 안에서 직접</span></div><span class="step stepMono">safe_publish_scheduled()</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip fresh"><span class="dot"></span>매분 · 입구 없음</span></span></div><figcaption class="cap">실행 주체를 데이터가 있는 곳으로 옮기면 입구도 그 코드도 필요 없어진다.</figcaption></figure></div>",
  "dompurify-uri/cause": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box"><span class="boxQ">속성이 URI-safe 목록에 있나?</span></div><div class="arrow"><span class="ln">→</span><span class="lb">아니오</span></div><div class="box boxNo">값을 URL 로 보고 검사 <span class="chip bad"><span class="dot"></span>type=checkbox → 제거</span></div></div><figcaption class="cap">DOMPurify 는 URI-safe 목록에 없는 속성의 값을 URL 일 수 있다고 보고 검사한다. type 은 그 목록에 없어 type=&quot;checkbox&quot; 값이 조용히 잘렸다.</figcaption></figure></div>",
  "dompurify-uri/definition": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">marked → &lt;input type=&quot;checkbox&quot;&gt; ✓</span><div class="arrow"><span class="ln">→</span><span class="lb">DOMPurify</span></div><span class="step"><span class="chip bad"><span class="dot"></span>사라짐 · 에러 0</span></span></div><figcaption class="cap">marked 는 체크박스를 제대로 만들었다. 사라진 건 DOMPurify 를 통과한 뒤였고, 에러는 발생하지 않았다.</figcaption></figure></div>",
  "dompurify-uri/insight": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">ALLOWED_ATTR</span><div class="arrow"><span class="ln">→</span><span class="lb">남길지? ✓</span></div><span class="step stepMono">ALLOWED_URI_REGEXP</span><div class="arrow"><span class="xmark">↮</span><span class="lb">값이 URL-safe?</span></div><span class="step"><span class="chip bad"><span class="dot"></span>조용히 제거 · 에러 0</span></span></div><div class="note"><div class="noteT"><span class="chip sync"><span class="dot"></span>전이 가능한 교훈</span></div><div class="noteP">이름만 보면 둘 다 “허용”이지만 축이 다르다 — 무엇을 남길지 vs 값이 URL 로 안전한지. 라이브러리 설정은 키 하나가 아니라 키들의 상호작용으로 읽어야 한다.</div></div><figcaption class="cap">한 키가 허용해도 다른 축의 키가 값을 보고 조용히 덮는다. 로그 없는 계층에선 에러 없음이 동작함의 근거가 못 된다.</figcaption></figure></div>",
  "dompurify-uri/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><span class="codePill">ADD_URI_SAFE_ATTR: [&quot;type&quot;,&quot;checked&quot;,&quot;disabled&quot;]</span><div class="arrow"><span class="ln">→</span></div><span class="chip fresh"><span class="dot"></span>URI 검사 건너뜀 → 체크박스 통과</span></div><figcaption class="cap">URL 이 아닌 inert 속성들을 URI 검사에서 빼 준다.</figcaption></figure></div>",
  "effect-order/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">자식 effect: 내 카메라 제어</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">부모 / 기본 fitView</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip bad"><span class="dot"></span>매 렌더 덮어씀</span></span></div><figcaption class="cap">useEffect 는 자식이 부모보다 먼저 실행된다. 게다가 react-flow 의 기본 fitView 는 리렌더마다 다시 돈다.</figcaption></figure></div>",
  "effect-order/definition": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">아무 노드나 클릭</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">fitView() 호출됨 ✓</span><div class="arrow"><span class="xmark">↮</span><span class="lb">확대·이동</span></div><span class="step"><span class="chip bad"><span class="dot"></span>화면 그대로 · 늘 같은 배율·위치</span></span></div><figcaption class="cap">fitView() 는 호출됐고 노드·엣지 연결도 정상인데, 어떤 노드를 눌러도 화면은 늘 같은 배율·같은 위치에서 멈췄다.</figcaption></figure></div>",
  "effect-order/insight": "<div class="viz"><figure class="fig"><div class="guard"><div class="guardRow"><div class="box"><span class="boxQ">증상: 아무 일도 안 일어남</span></div></div><div class="guardRow"><div class="box boxNo"><div class="boxQ">흔한 첫 추측</div>코드가 실행조차 안 됐다<div><span class="chip stale"><span class="dot"></span>대개 오답</span></div></div><div class="arrow"><span class="ln">→</span><span class="lb">먼저 여기</span></div><div class="box boxOk"><div class="boxQ">먼저 확인할 것</div>실행은 됐고 뒤에서 덮어써졌다<div><span class="chip fresh"><span class="dot"></span>나중 실행이 이긴다</span></div></div></div></div><figcaption class="cap">아무 일도 안 일어날 때는, 코드가 실행조차 안 됐다고 넘겨짚기 전에 실행은 됐는데 나중 동작이 덮어쓴 건 아닌지부터 본다.</figcaption></figure></div>",
  "effect-order/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><span class="codePill">fitView()</span><div class="arrow"><span class="ln">→</span><span class="lb">제거</span></div><div class="box boxOk">선언적 설정만 <span class="chip fresh"><span class="dot"></span>react-flow 단독 소유</span></div></div><figcaption class="cap">뷰포트 제어권을 하나로 통합했다. 명령형 fitView() 를 없애고, 설정만 선언한 뒤 react-flow 가 자기 순서에 스스로 맞추게 맡겼다.</figcaption></figure></div>",
  "fail-soft-notify/cause": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxNo">오류를 그대로 올림<span class="chip bad"><span class="dot"></span>트랜잭션 취소 · 발행 안 됨</span></div><div class="box boxOk">알림 실패는 삼킴<span class="chip fresh"><span class="dot"></span>발행은 예정대로</span></div></div><figcaption class="cap">두 실패의 무게가 다르다. 이메일은 나중에 화면에서 확인하면 되지만, 발행이 취소되면 글이 안 올라간다.</figcaption></figure></div>",
  "fail-soft-notify/solution": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">이메일 실패<span class="chip sync"><span class="dot"></span>무시 · 작업 계속</span></span><span class="step">작업 실패<span class="chip bad"><span class="dot"></span>admin_notifications 에 기록</span></span></div><figcaption class="cap">알림 실패는 조용히 넘기고, 작업 자체의 실패는 반드시 기록한다. 방향이 서로 반대다.</figcaption></figure></div>",
  "float-normalize/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">33.333 × 3 ≠ 100</span><div class="arrow"><span class="ln">→</span></div><span class="step">합≠100 → 재보정 → 또 ≠100 → …</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip bad"><span class="dot"></span>무한루프 · 탭 정지</span></span></div><figcaption class="cap">normalizer 는 열 너비 합이 100 이 아니면 다시 보정한다. 100/3 은 부동소수점으로 더해도 정확히 100 이 안 돼, 보정 → 여전히 ≠100 → 보정 … 종료조건에 영영 못 닿고 동기 루프가 탭을 얼린다.</figcaption></figure></div>",
  "float-normalize/definition": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">3열 만들기 · % 너비 조정</span><div class="arrow"><span class="ln">→</span><span class="lb">적용</span></div><span class="step"><span class="chip stale"><span class="dot"></span>에디터 정지</span></span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip bad"><span class="dot"></span>탭 응답 없음 · 크래시</span></span></div><figcaption class="cap">3열 블록을 만들거나 열 너비를 %로 조정하면 에디터가 그대로 굳었다. 탭이 응답을 멈추고 결국 크래시.</figcaption></figure></div>",
  "float-normalize/insight": "<div class="viz"><figure class="fig"><div class="cmp"><div class="ch"><span class="dim">합=100 만들기</span></div><div class="ch">오차를 허용</div><div class="ch">표현을 바꿈</div><div class="cell dim">종료조건</div><div class="cell"><span class="codePill">abs(sum-100) &lt; 0.01</span></div><div class="cell win"><span class="codePill">sum === 100</span></div><div class="cell dim">단단함</div><div class="cell"><span class="chip stale"><span class="dot"></span>오차를 견딤</span></div><div class="cell win"><span class="chip fresh"><span class="dot"></span>오차가 불가능</span></div></div><figcaption class="cap">종료조건이 안 닿을 땐 임계값을 늦추기보다, 목표가 정확히 표현되는 값 공간으로 옮기는 편이 단단하다.</figcaption></figure></div>",
  "float-normalize/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxOk">정수로만 재분배 (합 정확히 100) <span class="chip fresh"><span class="dot"></span>종료조건 도달</span></div></div><figcaption class="cap">오차를 허용하는 게 아니라, 오차가 생길 수 없는 정수 표현으로 옮겼다. 비율을 유지한 채 정수로 재분배하고 그 pass 를 즉시 끝낸다.</figcaption></figure></div>",
  "hook-order/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">decorate leaf (하이라이팅)</span><span class="step">+ mark leaf (bold/color)</span><div class="arrow"><span class="ln">→</span><span class="lb">겹침</span></div><span class="step"><span class="chip bad"><span class="dot"></span>hook 순서 바뀜 → 크래시</span></span></div><figcaption class="cap">코드블록은 하이라이팅용 decorate leaf 를 쓴다. 여기에 mark(bold·color) leaf 가 겹치면 렌더마다 leaf 구성이 달라져, Plate 의 Leaf 가 부르는 hook 순서가 바뀐다. React 규칙 위반이라 크래시.</figcaption></figure></div>",
  "hook-order/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxOk"><span class="boxQ">선택이 코드블록 안?</span> → addMark 무시 <span class="chip fresh"><span class="dot"></span>겹침 자체가 안 생김</span></div></div><figcaption class="cap">겹침을 렌더에서 수습하지 않고 입력 단계에서 막았다. 선택 영역이 코드블록 안이면 addMark 를 그냥 무시한다.</figcaption></figure></div>",
  "mousemove-rerender/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">mousemove <span class="dim">60/s</span></span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">setState</span><div class="arrow"><span class="ln">→</span></div><span class="step">25개+ 리렌더</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip bad"><span class="dot"></span>프레임 밀림 🐢</span></span></div><figcaption class="cap">고빈도 mousemove 가 매번 setState 를 불러 25개+ 아이템이 통째로 리렌더됐다.</figcaption></figure></div>",
  "mousemove-rerender/solution": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">mousemove</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">useRef</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">RAF → style.transform</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip fresh"><span class="dot"></span>리렌더 0</span></span></div><figcaption class="cap">state 대신 ref 에 값을 담고, 별도 RAF 루프에서 DOM transform 을 직접 수정한다. React 는 이 변화를 모른다.</figcaption></figure></div>",
  "oauth-authz/cause": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxOk"><div class="boxQ">인증 (authN)</div>이 사람이 진짜 이 GitHub 계정 주인인가<div><span class="chip fresh"><span class="dot"></span>OAuth 가 보장</span></div></div><div class="box boxNo"><div class="boxQ">인가 (authZ)</div>우리 사이트에 들어와도 되는 사람인가<div><span class="chip bad"><span class="dot"></span>아무도 안 봄</span></div></div></div><figcaption class="cap">OAuth 는 인증(authN)만 보장한다. 인가(authZ)는 전혀 다른 질문인데 아무도 확인하지 않았다.</figcaption></figure></div>",
  "oauth-authz/definition": "<div class="viz"><figure class="fig"><div class="row"><div class="dev"><div class="ic">🐙</div><div class="nm">GitHub 계정</div><span class="chip sync"><span class="dot"></span>누구나</span></div><div class="arrow"><span class="ln">→</span><span class="lb">콜백 통과</span></div><div class="dev"><div class="ic">🔓</div><div class="nm">세션 생성</div><span class="chip bad"><span class="dot"></span>로그인 성공</span></div></div><figcaption class="cap">OAuth 콜백이 통과하면 GitHub 계정만 있으면 누구든 세션이 생겼다.</figcaption></figure></div>",
  "oauth-authz/solution": "<div class="viz"><figure class="fig"><div class="guard"><div class="guardRow"><div class="box"><span class="boxQ">이메일 = OWNER_EMAIL / 역할 보유 / author_invites 초대?</span></div></div><div class="guardRow"><div class="arrow"><span class="ln">→</span><span class="lb">예</span></div><div class="box boxOk"><span class="chip fresh"><span class="dot"></span>로그인 통과</span></div><div class="arrow"><span class="ln">→</span><span class="lb">아니오</span></div><div class="box boxNo"><span class="chip bad"><span class="dot"></span>signOut + deleteUser</span></div></div></div><figcaption class="cap">세션 교환 직후 서버가 이메일을 검사한다. 셋 다 아니면 즉시 로그아웃하고 계정까지 지운다.</figcaption></figure></div>",
  "optimistic-lock/cause": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxNo"><span class="stepMono">잠금</span><span class="chip bad"><span class="dot"></span>풀 시점을 늘 관리</span></div><div class="box boxOk"><span class="stepMono">version</span><span class="chip fresh"><span class="dot"></span>어긋날 때만 409</span></div></div><figcaption class="cap">잠금은 드문 일을 막으려고 상시 비용을 낸다. 버전 번호는 어긋난 순간에만 걸린다.</figcaption></figure></div>",
  "optimistic-lock/definition": "<div class="viz"><figure class="fig"><div class="row"><div class="dev"><div class="ic">💻</div><div class="nm">노트북</div><span class="chip stale"><span class="dot"></span>v3 로 저장</span></div><div class="dev"><div class="ic">📱</div><div class="nm">휴대폰</div><span class="chip bad"><span class="dot"></span>v3 를 덮어씀</span></div></div><figcaption class="cap">두 화면이 같은 글을 열어 두면 나중 저장이 앞선 저장을 덮어쓴다.</figcaption></figure></div>",
  "optimistic-lock/solution": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">열 때 version = 7</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">.eq(&quot;version&quot;, 7)</span><div class="arrow"><span class="ln">→</span><span class="lb">일치하면</span></div><span class="step"><span class="chip fresh"><span class="dot"></span>저장 · version 8</span></span><div class="arrow"><span class="xmark">↮</span><span class="lb">어긋나면</span></div><span class="step"><span class="chip bad"><span class="dot"></span>409 conflict</span></span></div><figcaption class="cap">확인과 저장이 한 문장 안에 있어 그 사이에 다른 요청이 끼어들 틈이 없다.</figcaption></figure></div>",
  "percentage-height/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">부모: min-height <span class="dim">(definite 아님)</span></span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">자식: height 100%</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip bad"><span class="dot"></span>0 으로 붕괴</span></span></div><figcaption class="cap">height:100% 는 부모의 definite height 를 요구한다. min-height 로만 만든 높이는 auto 취급이라 자식의 100% 가 0 이 된다. 데스크탑은 flex 부모가 있어 우연히 살아 원인을 가렸다.</figcaption></figure></div>",
  "percentage-height/definition": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">.container { min-height }</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">.canvas { height:100% }</span><div class="arrow"><span class="ln">→</span><span class="lb">계산</span></div><span class="step"><span class="chip sync"><span class="dot"></span>DOM 노드 23개 존재</span> <span class="chip bad"><span class="dot"></span>0px · 안 보임</span></span></div><figcaption class="cap">모바일 컨테이너는 min-height 로만 높이를 받고, 그 안 캔버스의 height:100% 는 0 으로 계산됐다. 노드 23개가 DOM 엔 다 있는데 통째로 안 보였다 (데스크탑은 멀쩡).</figcaption></figure></div>",
  "percentage-height/insight": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">부모: min-height 만</span><div class="arrow"><span class="ln">→</span><span class="lb">자식 height:100%</span></div><span class="step"><span class="chip bad"><span class="dot"></span>0 · indefinite</span></span></div><div class="guardRow"><div class="box boxOk">부모 height (definite) <span class="chip fresh"><span class="dot"></span>채움</span></div><div class="box boxOk">flex / grid stretch <span class="chip fresh"><span class="dot"></span>definite 불필요</span></div></div><figcaption class="cap">percentage height 는 definite height 를 요구한다. min-height 는 definite 가 아니라 100% 가 0 으로 죽고, 진짜 height 나 flex/grid stretch 는 채운다.</figcaption></figure></div>",
  "percentage-height/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><span class="codePill">display: flex; flex-direction: column</span><div class="arrow"><span class="ln">→</span></div><div class="box boxOk"><span class="chip fresh"><span class="dot"></span>자식이 stretch 로 채움</span></div></div><figcaption class="cap">컨테이너를 flex column 으로 만들어 자식을 stretch 로 늘렸다. flex stretch 는 부모 높이가 definite 인지와 무관하게 동작한다.</figcaption></figure></div>",
  "perceptual-color/cause": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box">노랑 L 50% <span class="chip fresh"><span class="dot"></span>밝게 느낌</span></div><div class="box">보라 L 50% <span class="chip stale"><span class="dot"></span>어둡게 느낌</span></div></div><figcaption class="cap">HSL 의 lightness 는 (max+min)/2 수학 평균일 뿐, 지각 밝기와 다르다. 같은 L 50% 라도 노랑은 밝게, 보라는 어둡게 느껴진다.</figcaption></figure></div>",
  "perceptual-color/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><span class="codePill">oklch(L% C H)</span><div class="arrow"><span class="ln">→</span></div><div class="box boxOk"><span class="chip fresh"><span class="dot"></span>같은 L = 같은 지각 밝기</span></div></div><figcaption class="cap">모든 토큰을 OKLCH 로 옮겼다. OKLCH 의 L 은 hue 와 무관하게 같은 지각 밝기를 준다. sRGB 밖으로 나가는 건 hue 별 safeChroma 로 clipping 을 피했다.</figcaption></figure></div>",
  "perm-store/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">클라이언트</span><div class="arrow"><span class="ln">→</span><span class="lb">updateUser()</span></div><span class="step stepMono">Supabase Auth</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip bad"><span class="dot"></span>user_metadata 변경</span></span></div><div class="steps"><span class="step dim">사이트 API</span><span class="chip stale"><span class="dot"></span>경로에 없음</span></div><figcaption class="cap">user_metadata 수정 요청은 사이트를 지나지 않는다. 사이트에는 검사할 자리가 없다.</figcaption></figure></div><div class="viz"><figure class="fig"><div class="steps"><span class="step">클라이언트</span><div class="arrow"><span class="ln">→</span><span class="lb">권한 변경 요청</span></div><span class="step">우리 서버<span class="chip fresh"><span class="dot"></span>service-role</span></span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">Supabase Auth</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip fresh"><span class="dot"></span>app_metadata 변경</span></span></div><figcaption class="cap">app_metadata 는 서버를 거쳐야만 바뀐다. service-role 키가 서버에만 있기 때문이다.</figcaption></figure></div><div class="viz"><figure class="fig"><div class="stack"><div class="steps"><span class="step stepMono">app_metadata</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">getUser()<span class="chip fresh"><span class="dot"></span>사용자 + 역할</span></span><div class="arrow"><span class="ln">→</span><span class="lb">끝</span></div><span class="step"><span class="chip fresh"><span class="dot"></span>조회 추가 없음</span></span></div><div class="steps"><span class="step stepMono">권한 테이블</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">getUser()<span class="chip sync"><span class="dot"></span>사용자만</span></span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">SELECT<span class="chip stale"><span class="dot"></span>역할 조회</span></span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip stale"><span class="dot"></span>조회 1회 추가</span></span></div></div><figcaption class="cap">인증 확인은 어느 쪽이든 일어난다. 갈리는 것은 그 뒤에 조회가 붙느냐다.</figcaption></figure></div>",
  "perm-store/solution": "<div class="viz"><figure class="fig"><div class="row seq"><div class="dev"><span class="seqNum">1</span><div class="ic">🔑</div><div class="nm">getUser()</div><div class="sub">인증 확인</div></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><span class="seqNum">2</span><div class="ic">🏷️</div><div class="nm">app_metadata</div><div class="sub">역할 · 레벨</div></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><span class="seqNum">3</span><div class="ic">📄</div><div class="nm">canEditPost</div><div class="sub">대상 글 소유권</div></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><span class="seqNum">4</span><div class="ic">✅</div><div class="nm">요청 처리</div><div class="sub">통과</div></div></div><figcaption class="cap">인증·역할·글 소유권을 차례로 확인하고 요청을 처리한다.</figcaption></figure></div>",
  "pointer-capture/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">onPointerDown<br/>setPointerCapture</span><div class="arrow"><span class="ln">→</span></div><span class="step">모든 pointer 이벤트 → sphere</span><div class="arrow"><span class="ln">→</span></div><span class="step"><span class="chip bad"><span class="dot"></span>자식 Link click 안 먹힘</span></span></div><figcaption class="cap">드래그 시작 시 setPointerCapture 를 걸면 그 pointer 의 모든 이벤트가 캡처 요소로 라우팅된다. 떼는 순간의 click 까지 sphere 가 가로채, 자식 Link 로 안 간다.</figcaption></figure></div>",
  "pointer-capture/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><span class="step stepMono">document pointermove / up</span><div class="arrow"><span class="ln">→</span></div><div class="box boxOk"><span class="chip fresh"><span class="dot"></span>회전 O</span> <span class="chip fresh"><span class="dot"></span>클릭 O</span></div></div><figcaption class="cap">sphere 에 capture 를 걸지 않고 document 레벨 pointermove/up 으로 회전을 추적한다. 밖으로 나가도 회전은 그대로, click 은 자식으로 통과.</figcaption></figure></div>",
  "popular-single-source/definition": "<div class="viz"><figure class="fig"><div class="row"><div class="dev"><div class="nm">HOT 배지</div><div class="sub">view 상위 5</div></div><div class="dev"><div class="nm">정렬 popular</div><div class="sub">자체 가중치</div></div><div class="dev"><div class="nm">삭제 보호</div><div class="sub">절대 임계값</div></div></div><div class="guardRow"><span class="chip bad"><span class="dot"></span>세 곳이 서로 다른 답 → 정의가 어긋남</span></div><figcaption class="cap">&#x27;인기&#x27;가 세 곳에서 따로 정의돼, 서로 다른 답을 냈다.</figcaption></figure></div>",
  "popular-single-source/solution": "<div class="viz"><figure class="fig"><div class="steps"><span class="step stepMono">lib/popularity.ts<br/>scoreOf() · getPopularPostIds()</span><div class="arrow"><span class="ln">→</span></div><span class="step">HOT 배지</span><span class="step">정렬</span><span class="step">삭제 보호</span></div><div class="guardRow"><span class="chip fresh"><span class="dot"></span>세 기능이 자동으로 같은 답</span></div><figcaption class="cap">한 모듈로 정의를 모으고, 세 기능이 모두 이걸 호출한다. 가중치는 한 줄만 고치면 세 곳이 함께 따른다.</figcaption></figure></div>",
  "recaptcha-lazy/cause": "<div class="viz"><figure class="fig"><div class="bars"><div class="barRow"><span class="barLabel">즉시 로드</span><div class="track"><span class="seg segBad" style="width:95%"></span></div><span class="barVal">17.1s</span></div><div class="barRow"><span class="barLabel">지연 로드</span><div class="track"><span class="seg segOk" style="width:14%"></span></div><span class="barVal">~2s</span></div></div><figcaption class="cap">784KB 스크립트를 앱 초기화에 즉시 로드해 첫 화면을 블로킹했다. LCP 가 17초까지 밀렸다.</figcaption></figure></div>",
  "recaptcha-lazy/solution": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">앱 초기화</span><div class="arrow"><span class="ln">→</span><span class="lb">전엔 여기서 로드</span></div><span class="step">첫 클릭 / 스크롤</span><div class="arrow"><span class="ln">→</span><span class="lb">이제 여기서</span></div><span class="step"><span class="chip fresh"><span class="dot"></span>reCAPTCHA 로드</span></span></div><figcaption class="cap">페이지를 읽기만 하고 떠나는 대다수 방문자는 이 스크립트를 아예 받지 않는다.</figcaption></figure></div>",
  "reversible-delete/cause": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxNo"><span class="stepMono">DELETE FROM</span><span class="chip bad"><span class="dot"></span>복구 = 백업 복원</span></div><div class="box boxOk"><span class="stepMono">deleted_at = now()</span><span class="chip fresh"><span class="dot"></span>휴지통에서 복구</span></div></div><figcaption class="cap">행을 지우면 되돌릴 방법이 백업 복원뿐이다. 운영자가 한 명이라 대신 해 줄 사람도 없다.</figcaption></figure></div>",
  "reversible-delete/solution": "<div class="viz"><figure class="fig"><div class="row seq"><div class="dev"><span class="seqNum">1</span><div class="ic">🗑️</div><div class="nm">삭제</div><div class="sub">deleted_at</div></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><span class="seqNum">2</span><div class="ic">♻️</div><div class="nm">휴지통</div><div class="sub">복구 가능</div></div><div class="arrow"><span class="ln">→</span><span class="lb">기한 경과</span></div><div class="dev"><span class="seqNum">3</span><div class="ic">⏱️</div><div class="nm">영구 삭제</div><div class="sub">purge_after</div></div></div><figcaption class="cap">삭제는 세 단계로 나뉜다. 영구 삭제까지 두 번의 관문이 있다.</figcaption></figure></div>",
  "revision-cap/cause": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxNo">30일 지난 것 삭제<span class="chip bad"><span class="dot"></span>오래된 글 = 0개</span></div><div class="box boxOk">최근 50개만 유지<span class="chip fresh"><span class="dot"></span>항상 되돌릴 거리 있음</span></div></div><figcaption class="cap">기간으로 자르면 오래된 글은 되돌릴 거리가 하나도 남지 않는다. 개수로 자르면 나이와 무관하게 최근 것이 남는다.</figcaption></figure></div>",
  "revision-cap/solution": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">새 리비전 저장</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">최신순 정렬</span><div class="arrow"><span class="ln">→</span></div><span class="step stepMono">range(50, …)</span><div class="arrow"><span class="ln">→</span><span class="lb">초과분</span></div><span class="step"><span class="chip fresh"><span class="dot"></span>51번째부터 삭제</span></span></div><figcaption class="cap">저장할 때마다 정리해서 상한을 넘긴 상태로 오래 머무르지 않는다.</figcaption></figure></div>",
  "sticky-frost/definition": "<div class="viz"><figure class="fig"><div class="row"><div class="dev"><div class="ic">🫧</div><div class="nm">sticky 바</div><span class="chip bad"><span class="dot"></span>blur 안 보임</span></div><div class="arrow"><span class="ln">→</span></div><div class="dev"><div class="ic">🧊</div><div class="nm">sticky 바</div><span class="chip fresh"><span class="dot"></span>frost 보임</span></div></div><figcaption class="cap">blur 는 뒤 콘텐츠와 자체 stacking context 가 있어야 보인다. 둘 중 하나가 없어 frost 가 옅거나 잘렸다.</figcaption></figure></div>",
  "sticky-frost/solution": "<div class="viz"><figure class="fig"><div class="note"><div class="noteT">🧊 frost 가 보이는 조건</div><p class="noteP">① positioned 요소 자체에 backdrop-filter 를 건다  ② 바 뒤로 흐릴 콘텐츠가 실제로 지나가게 한다  ③ -webkit- prefix 는 빼서 blur 가 파서에서 무효화되지 않게 한다.</p></div></figure></div>",
  "transition-shorthand/cause": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxNo"><span class="codePill">html[data-theme-ready] *</span><div class="sub">specificity (0,1,1)</div><span class="chip bad"><span class="dot"></span>이김 · 전체 대체</span></div><div class="box"><span class="codePill">.modal</span><div class="sub">(0,1,0)</div><span class="chip stale"><span class="dot"></span>max-height 전환 사라짐</span></div></div><figcaption class="cap">전역 규칙의 specificity 가 더 높고, transition 은 shorthand 라 컴포넌트 transition 을 통째로 대체한다.</figcaption></figure></div>",
  "transition-shorthand/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><span class="codePill">.modal</span><div class="arrow"><span class="ln">→</span><span class="lb">(0,1,0) → (0,2,0)</span></div><div class="box boxOk"><span class="codePill">.modalWrap .modal</span> <span class="chip fresh"><span class="dot"></span>(0,1,1) 이김 → 전환 복원</span></div></div><figcaption class="cap">컴포넌트 선택자를 복합 선택자로 바꿔 specificity 를 전역보다 높인다.</figcaption></figure></div>",
  "unique-constraint/cause": "<div class="viz"><figure class="fig"><div class="steps"><span class="step">요청 A 조회 <span class="chip sync"><span class="dot"></span>기록 없음</span></span><span class="step">요청 B 조회 <span class="chip sync"><span class="dot"></span>기록 없음</span></span><div class="arrow"><span class="ln">→</span><span class="lb">둘 다 삽입</span></div><span class="step"><span class="chip bad"><span class="dot"></span>중복 2건</span></span></div><figcaption class="cap">두 요청이 겹치면 둘 다 &#x27;기록 없음&#x27; 을 보고 둘 다 넣는다. 확인과 삽입 사이가 비어 있어서다.</figcaption></figure></div>",
  "unique-constraint/solution": "<div class="viz"><figure class="fig"><div class="guardRow"><div class="box boxNo">코드에서 확인<span class="chip bad"><span class="dot"></span>조회 → 삽입 사이에 틈</span></div><div class="arrow"><span class="ln">→</span></div><div class="box boxOk"><span class="stepMono">UNIQUE INDEX</span><span class="chip fresh"><span class="dot"></span>두 번째 삽입은 거절</span></div></div><figcaption class="cap">제약을 걸면 순서가 어떻게 얽히든 살아남는 행은 하나다.</figcaption></figure></div>",
}
`;
